{
  "name": "formatting-controls",
  "version": "0.4.0",
  "description": "Control formatting, save actions, and language settings from a theme-aware dashboard with explicit configuration scopes.",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview-ui/tsconfig.json",
    "lint": "biome check .",
    "test": "bun run build && node --test dist/test/unit/*.js",
    "test:integration": "bun run build && bun run test/run-integration.ts",
    "package": "bun run scripts/package.ts",
    "vscode:prepublish": "bun run build",
    "format": "biome check --write .",
    "test:ui": "bun run build && bun run test/run-integration.ts --ui",
    "release:check": "bun run scripts/release-check.ts",
    "security:check": "bun run scripts/audit.ts"
  },
  "author": {
    "name": "Raju Dhami",
    "email": "imrajudhami@gmail.com",
    "url": "https://github.com/Raju"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "@types/yauzl": "3.4.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "axe-core": "4.14.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "yauzl": "3.4.0"
  },
  "displayName": "Formatting Controls",
  "publisher": "rajudhami",
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=24"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "formattingControls.open",
        "title": "Formatting Controls: Quick Controls"
      },
      {
        "command": "formattingControls.inspect",
        "title": "Formatting Controls: Inspect Effective Settings"
      },
      {
        "command": "formattingControls.dashboard",
        "title": "Formatting Controls: Open Dashboard"
      },
      {
        "command": "formattingControls.welcome",
        "title": "Formatting Controls: Getting Started"
      },
      {
        "command": "formattingControls.restore",
        "title": "Formatting Controls: Restore Previous Settings"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kira-explore/formatting-controls.git"
  },
  "homepage": "https://github.com/kira-explore/formatting-controls#readme",
  "bugs": {
    "url": "https://github.com/kira-explore/formatting-controls/issues"
  },
  "packageManager": "bun@1.4.4",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "keywords": [
    "formatting",
    "code actions",
    "profiles",
    "biome",
    "prettier",
    "eslint"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Settings inspection is available. Editing, profile file dialogs and providers depend on the workspace filesystem and host."
    }
  },
  "overrides": {
    "@azure/identity@4.14.0>@azure/msal-node": "7.1.1"
  }
}
